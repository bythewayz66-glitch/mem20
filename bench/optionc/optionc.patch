+            # Squash the logits to (0, 1) before blending. The RRF term is
+            # already in (0, 1) because 1/(k_rrf + rank + 1) <= 1/61, so a
+            # logistic keeps the cross-encoder's ordering while making the two
+            # terms commensurate.
+            squashed = [1.0 / (1.0 + math.exp(-float(s))) for s in ce_scores]
