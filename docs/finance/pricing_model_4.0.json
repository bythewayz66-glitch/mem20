      "basis": "analyst assumption: share of Team buyers who would pay for the governance bundle if it were sold separately rather than bundled. Stress-tested 0.15-0.45."
    },
    "win_rate_at_list": {
      "value": 0.34,
      "basis": "analyst assumption for a category with no published mem20 win data. Used only to shape the sensitivity curve, never to state an actual win rate."
    }
