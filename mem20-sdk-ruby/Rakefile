# frozen_string_literal: true

require "rspec/core/rake_task"

RSpec::Core::RakeTask.new(:spec)

desc "Run RuboCop"
task :rubocop do
  require "rubocop"
  exit RuboCop::CLI.new.run(["--format", "simple"])
end

desc "Build the gem"
task :build do
  sh "gem build mem20-sdk.gemspec"
end

# --- surface:check ---------------------------------------------------------
#
# Compares Mem20::Surface with the authoritative live manifest in
# docs/surface.json, which scripts/surface_manifest.py generates from a real
# `tools/list` response and cross-checks against the AST catalog in
# web/src/data/tools.json. The counts quoted in the README and docs/ went stale
# three different ways (257 / 268 / 270) precisely because nothing recounted
# them against the live surface.
#
#   rake surface:check
module SurfaceCheck
  REPO_ROOT = File.expand_path("..", __dir__)
  SURFACE_JSON = File.join(REPO_ROOT, "docs", "surface.json")

  DRIFT_MESSAGE = "surface drift detected - update lib/mem20/surface.rb " \
                  "and the counts in README.md/docs/"

  module_function

  def manifest
    require "json"
    JSON.parse(File.read(SURFACE_JSON))
  end

  def mismatch(label, got, want, const_name)
    return nil if got == want

    "#{label}: docs/surface.json #{got} != Surface::#{const_name} #{want}"
  end

  def problems
    data = manifest
    live_tools = data.fetch("tools")
    live_domains = data.fetch("domains")
    [
      mismatch("total tools", live_tools, Mem20::Surface::TOOL_COUNT, "TOOL_COUNT"),
      mismatch("domains", live_domains, Mem20::Surface::DOMAIN_COUNT, "DOMAIN_COUNT"),
      mismatch("domain tools", live_tools, Mem20::Surface::DOMAIN_TOOLS, "DOMAIN_TOOLS")
    ].compact
  end

  def report
    data = manifest
    puts "manifest: #{data['tools']} tools across #{data['domains']} domains (docs/surface.json)"
    puts "surface:  #{Mem20::Surface.summary}"
  end

  def run!
    abort "rake surface:check: no docs/surface.json at #{SURFACE_JSON}" unless File.exist?(SURFACE_JSON)

    require_relative "lib/mem20/surface"

    report
    problems.each { |problem| warn "MISMATCH #{problem}" }
    abort DRIFT_MESSAGE unless problems.empty?

    puts "OK - Mem20::Surface matches docs/surface.json"
  end
end

namespace :surface do
  desc "Compare Mem20::Surface with the live manifest in docs/surface.json"
  task :check do
    SurfaceCheck.run!
  end
end

task default: :spec
