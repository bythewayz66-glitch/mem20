# frozen_string_literal: true

require "rspec/core/rake_task"

RSpec::Core::RakeTask.new(:spec)

desc "Run RuboCop"
task :rubocop do
  require "rubocop"
  exit RuboCop::CLI.new.run(["--format", "simple"])
end

desc "Build the gem"
task :build do
  sh "gem build mem20-sdk.gemspec"
end

# --- surface:check ---------------------------------------------------------
#
# Compares Mem20::Surface with the repository's authoritative surface manifest.
#
# The counts quoted in the README and docs/ went stale several different ways
# (257 / 268 / 270 / 272) precisely because nothing recounted them. The old
# version of this task recounted by scanning `mcp/**/*.py` for
# `self.tools["name"] =` assignments. That scan is no longer a valid measure of
# the live surface: the server now composes its tool table from mixins that are
# imported conditionally, several modules define a `register_*_tools` function
# that `_setup_tools()` never calls, and a handful of names are assigned twice.
# A naive scan therefore reports 92 modules / 427 tools against a live surface
# of 311 / 39 -- a false drift signal, not a real one.
#
# The authoritative figure is `docs/surface.json`, which
# `scripts/surface_manifest.py` generates from a live `tools/list` response and
# cross-checks against the AST catalog in `web/src/data/tools.json`; the
# generator refuses to emit unless the two collections are identical. CI runs
# `python3 scripts/surface_manifest.py --check` on the same file. This task
# reads that file, so the gem and the repository cannot disagree.
#
# Run from the SDK directory with the repo checked out one level up:
#
#   rake surface:check
module SurfaceCheck
  REPO_ROOT = File.expand_path("..", __dir__)
  MANIFEST = File.join(REPO_ROOT, "docs", "surface.json")

  DRIFT_MESSAGE = "surface drift detected - update lib/mem20/surface.rb " \
                  "and the counts in README.md/docs/"

  module_function

  # The manifest is JSON; parse it without pulling in a gem dependency.
  def manifest
    abort "rake surface:check: no docs/surface.json at #{MANIFEST}" unless File.exist?(MANIFEST)

    require "json"
    JSON.parse(File.read(MANIFEST))
  end

  def measure
    data = manifest
    {
      tools: data.fetch("tools"),
      domains: data.fetch("domains"),
      cross_check: data.fetch("cross_check", {})
    }
  end

  def actual
    @actual ||= measure
  end

  def mismatch(label, got, want, const_name)
    return nil if got == want

    "#{label}: manifest #{got} != Surface::#{const_name} #{want}"
  end

  def cross_check_problems
    cc = actual[:cross_check]
    return [] if cc.empty?

    problems = []
    if cc["ast_tools"] != actual[:tools]
      problems << "manifest cross_check.ast_tools #{cc['ast_tools']} != tools #{actual[:tools]}"
    end
    if cc["ast_domains"] != actual[:domains]
      problems << "manifest cross_check.ast_domains #{cc['ast_domains']} != domains #{actual[:domains]}"
    end
    unless Array(cc["only_ast"]).empty? && Array(cc["only_live"]).empty?
      problems << "manifest cross_check is not clean: only_ast=#{cc['only_ast'].inspect} " \
                  "only_live=#{cc['only_live'].inspect}"
    end
    problems
  end

  def problems
    [
      mismatch("total tools", actual[:tools], Mem20::Surface::TOOL_COUNT, "TOOL_COUNT"),
      mismatch("domain count", actual[:domains], Mem20::Surface::DOMAIN_COUNT, "DOMAIN_COUNT")
    ].compact + cross_check_problems
  end

  def report
    puts "manifest: #{actual[:tools]} tools across #{actual[:domains]} domains " \
         "(#{MANIFEST})"
    puts "surface:  #{Mem20::Surface.summary}"
  end

  def run!
    require_relative "lib/mem20/surface"

    report
    problems.each { |problem| warn "MISMATCH #{problem}" }
    abort DRIFT_MESSAGE unless problems.empty?

    puts "OK - Mem20::Surface matches docs/surface.json"
  end
end

namespace :surface do
  desc "Compare Mem20::Surface with docs/surface.json"
  task :check do
    SurfaceCheck.run!
  end
end

task default: :spec
