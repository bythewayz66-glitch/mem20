# OREO editor — production build settings.
#
# VITE_LLM_MODE=pollinations wires the deployed site to a REAL LLM with no API
# key and no server of your own: the browser POSTs an OpenAI-compatible chat
# body straight to a public endpoint. Set it to `mock` to run fully offline,
# or `live` to point each agent at an endpoint you host.
VITE_LLM_MODE=pollinations
VITE_LLM_ENDPOINT=https://text.pollinations.ai/openai
VITE_LLM_MODEL=openai-fast
