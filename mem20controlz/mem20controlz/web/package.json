{
  "name": "mem20controlz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operations console frontend for the mem20 control plane (same-origin API).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test 'test/**/*.js'",
    "desktop:dev": "cd ../../src-tauri && npm --prefix ../mem20controlz/web exec tauri dev",
    "desktop:build": "cd ../../src-tauri && npm --prefix ../mem20controlz/web exec tauri build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
