{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mem20controlz",
  "version": "0.1.0",
  "identifier": "com.mem20.controlz",
  "build": {
    "beforeDevCommand": "npm --prefix mem20controlz/web run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix mem20controlz/web run build",
    "frontendDist": "../mem20controlz/static",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "mem20 control plane",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Unified control plane for the mem20 fleet",
    "longDescription": "Desktop shell for the mem20 control plane. Reuses the existing React console, owns the backend lifecycle, reports tray health, and receives signed updates."
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAxQUQxRDQ0QTYxM0I2RDEKUldUUnRoT21SQjJ0QVUrYmtibWhsYXNwdlFQRXh0UzVqMWQ5dGlnMzQyWXk5YWNSQzY1L002MmgK",
      "endpoints": [
        "https://github.com/bythewayz66-glitch/mem20/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
