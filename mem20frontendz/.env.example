# Upstreams for the three proxied prefixes (dev + preview server).
MEM20_DOOR_URL=http://127.0.0.1:8221
MEM20_CONTROL_URL=http://127.0.0.1:8200
MEM20_MCP_URL=http://127.0.0.1:8082

# 'snapshot' falls back to the checked-in captures and labels them.
# 'live' forbids the fallback so a dead backend renders an error.
VITE_SOURCE_MODE=snapshot

# teamz chat transport: 'mock' answers locally, 'live' calls each agent endpoint.
VITE_API_MODE=mock
