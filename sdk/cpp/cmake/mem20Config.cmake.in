@PACKAGE_INIT@

# mem20 C++ SDK package config.
#
#   find_package(mem20 CONFIG REQUIRED)
#   target_link_libraries(app PRIVATE mem20::mem20)
#
# Imported target: mem20::mem20
#   INTERFACE_INCLUDE_DIRECTORIES -> <prefix>/include
#   INTERFACE_LINK_LIBRARIES      -> Threads::Threads (POSIX stdio transport)

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/mem20Targets.cmake")

# The tool/domain surface this package was built against is available in the
# public header <mem20/surface.hpp>; nothing is resolved at configure time.
check_required_components(mem20)
